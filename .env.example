# Run python3 scripts/init-env.py to generate a private .env for local development.
# Supply separate secrets through your deployment platform in production.
DB_USER=quizlet_user
DB_NAME=quizlet_db
DB_PASSWORD=
JWT_SECRET=
# Optional: trusted immediate peers that forward Cloudflare's verified client address.
# Native cloudflared on the same machine: 127.0.0.1/32,::1/128
TRUSTED_PROXY_CIDRS=
# Optional integrations (leave blank to run without paid providers):
YANDEX_DICTIONARY_API_KEY=
DEEPSEEK_API_KEY=
FORVO_API_KEY=
